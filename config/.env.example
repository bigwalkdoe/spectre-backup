# spectre-backup Configuration
# Copy this to ~/.config/spectre-backup/.env (workstations) or /etc/spectre-backup/.env (servers)
# The password file goes in ~/.config/spectre-backup/password (chmod 600) for workstations,
# or /etc/spectre-backup/password (chmod 600) for servers.

# --- Machine role: workstation or server ---
# Affects systemd unit type (user vs system), default scopes, notifications.
# Set via installer flag or env var; defaults to auto-detect.
SPECTRE_BACKUP_ROLE="workstation"

# --- Storage Backend ---
# Offsite repository (rclone remote, S3, etc.)
RESTIC_REPOSITORY="rclone:spectre-backup:"

# Optional local repository (e.g. /backups/restic or /mnt/backup/restic).
# When set, backups go to local first, then offsite. A failed offsite leg
# does not prevent the local backup.
# RESTIC_REPOSITORY_LOCAL="/backups/restic"

# --- Logging ---
LOG_DIR="${HOME}/.local/state/spectre-backup"

# --- PostgreSQL ---
# Connect via local socket with peer auth
# Requires matching PostgreSQL role for your user
PG_ENABLED="true"
PG_HOST="/var/run/postgresql"
PG_PORT="5432"
PG_USER="deon"

# --- Container Backup ---
CONTAINERS_ENABLED="true"

# --- Notifications ---
# Desktop notifications only make sense on workstations.
NOTIFY_ENABLED="true"
NOTIFY_DESKTOP="true"
