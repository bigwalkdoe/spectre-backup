# Modelink Backup Configuration
# Copy this to ~/.config/modelink-backup/.env
# The password file goes in ~/.config/modelink-backup/password (chmod 600)

# --- Storage Backend ---
RESTIC_REPOSITORY="rclone:gdrive:ModelinkBackups/workstation"

# --- Logging ---
LOG_DIR="${HOME}/.local/state/modelink-backup"

# --- PostgreSQL ---
# Connect via local socket with peer auth
# Requires matching PostgreSQL role for your user
PG_ENABLED="true"
PG_HOST="/var/run/postgresql"
PG_PORT="5432"
PG_USER="deon"

# --- Container Backup ---
CONTAINERS_ENABLED="true"

# --- Notifications ---
NOTIFY_ENABLED="true"
NOTIFY_DESKTOP="true"
