# Modelink Backup Configuration
# Copy this to ~/.config/modelink-backup/.env
# The password file goes in ~/.config/modelink-backup/password (chmod 600)

# --- Storage Backend ---
# Default: rclone remote named "gdrive" storing in ModelinkBackups/workstation
RESTIC_REPOSITORY="rclone:gdrive:ModelinkBackups/workstation"

# --- Logging ---
LOG_DIR="${HOME}/.local/state/modelink-backup"

# --- PostgreSQL ---
PG_ENABLED="true"
PG_HOST="localhost"
PG_PORT="5432"
PG_USER=""
PG_PASSWORD=""

# --- Container Backup ---
CONTAINERS_ENABLED="true"

# --- Notifications ---
NOTIFY_ENABLED="true"
NOTIFY_DESKTOP="true"

# --- Backup Scope ---
# Include file: paths to back up (one per line)
INCLUDE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/modelink-backup/include.conf"
# Exclude file: patterns to exclude (restic golang patterns, one per line)
EXCLUDE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/modelink-backup/exclude.conf"
