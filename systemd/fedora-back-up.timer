[Unit]
Description=fedora-back-up Timer - daily workstation/server backup
Documentation=https://github.com/bigwalkdoe/spectre-backup

[Timer]
# Daily at 4 AM with random delay to avoid thundering herd
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=3600

[Install]
WantedBy=timers.target
